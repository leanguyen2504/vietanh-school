# Sao chép thành .env.local và điền giá trị từ Supabase > Project Settings > API
# KHÔNG commit .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Chỉ dùng phía server (tạo/mời tài khoản trong trang Cấu hình). Không bao giờ để lộ ra trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=
# URL của website (dùng cho liên kết đặt lại mật khẩu)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
